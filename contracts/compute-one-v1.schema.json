{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonarch.app/contracts/compute-one-v1.schema.json",
  "title": "Compute ONE v1 bounded fixture WorkUnit (not production F09 stream)",
  "description": "The application MUST independently verify canonical SHA256 roots and base64 bytes; JSON Schema alone is insufficient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workunit_id",
    "tenant",
    "epoch",
    "attempt",
    "op",
    "tensors",
    "state_root",
    "wire_root"
  ],
  "properties": {
    "schema": {
      "const": "resonarch.compute-one.workunit.v1"
    },
    "workunit_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "op": {
      "enum": [
        "checksum32",
        "xor_u8",
        "cuda13_only_reverse"
      ]
    },
    "tensors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "dtype",
          "shape",
          "byte_length",
          "sha256",
          "data_b64"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "dtype": {
            "enum": [
              "u8",
              "i32le",
              "f32le"
            ]
          },
          "shape": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            }
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "data_b64": {
            "type": "string",
            "maxLength": 1398104
          }
        }
      }
    },
    "state_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "wire_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
