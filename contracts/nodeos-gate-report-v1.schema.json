{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonarch.example/contracts/nodeos-gate-report-v1.schema.json",
  "title": "NodeOS gate report",
  "type": "object",
  "required": ["schema", "node_id", "boot_id", "state", "verdict", "gates"],
  "properties": {
    "schema": { "const": "resonarch.nodeos.gate-report.v1" },
    "node_id": { "type": "string" },
    "boot_id": { "type": "string" },
    "state": { "type": "string" },
    "state_reason": { "type": "string" },
    "stage": { "type": "string" },
    "verdict": { "enum": ["PASS", "FAIL", "INCOMPLETE"] },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "stage", "status", "blocking"],
        "properties": {
          "name": { "enum": ["uefi", "kernel", "nic", "link", "gpu", "payload", "driver", "cuda", "network"] },
          "stage": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "NA", "SKIPPED"] },
          "reason": { "type": "string" },
          "detail": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    }
  }
}
