{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resonarch.example/contracts/nodeos-evidence-manifest-v1.schema.json",
  "title": "NodeOS physical-run evidence manifest",
  "description": "Evidence ID = SHA-256 of this manifest file. SHA256SUMS covers every file including the manifest.",
  "type": "object",
  "required": ["schema", "node_id", "boot_id", "state", "verdict", "files"],
  "properties": {
    "schema": { "const": "resonarch.nodeos.evidence-manifest.v1" },
    "node_id": { "type": "string" },
    "boot_id": { "type": "string" },
    "created_utc": { "type": "string" },
    "uptime_s": { "type": ["integer", "null"] },
    "state": { "type": "string" },
    "state_reason": { "type": "string" },
    "verdict": { "enum": ["PASS", "FAIL", "INCOMPLETE"] },
    "profile": { "type": "string" },
    "nodeos_commit": { "type": "string" },
    "buildroot_commit": { "type": "string" },
    "missing": { "type": "string" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "bytes", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
