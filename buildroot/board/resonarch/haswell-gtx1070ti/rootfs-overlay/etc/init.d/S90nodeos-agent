#!/bin/sh
set -eu
PIDFILE=/run/nodeos/nodeos-agent.pid

case "${1:-start}" in
 start)
    mkdir -p /run/nodeos /var/log
    if [ -r "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then exit 0; fi
    /usr/sbin/nodeos-agent run >>/var/log/nodeos-agent.log 2>&1 &
    echo $! > "$PIDFILE"
    ;;
 stop)
    if [ -r "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
    ;;
 restart) "$0" stop; "$0" start ;;
 *) echo "usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
