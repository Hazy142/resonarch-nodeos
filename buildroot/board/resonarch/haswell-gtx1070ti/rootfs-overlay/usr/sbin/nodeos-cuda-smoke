#!/bin/sh
set -eu
QUIET=0
[ "${1:-}" = "--quiet" ] && QUIET=1
RUN=${NODEOS_RUN:-/run/nodeos}
ETC=${NODEOS_ETC:-/etc/nodeos}
PROBE=${NODEOS_CUDA_PROBE:-/usr/libexec/nodeos-cuda-probe}
OUT=$RUN/cuda-smoke.json
mkdir -p "$RUN"

fail() {
    reason="$1"
    printf '{"schema":"resonarch.nodeos.cuda-smoke.v1","status":"FAIL","reason":"%s"}\n' "$reason" > "$OUT"
    [ "$QUIET" -eq 1 ] || cat "$OUT"
    exit 1
}

command -v nvidia-smi >/dev/null 2>&1 || fail "nvidia-smi-missing"
nvidia-smi -L >/dev/null 2>&1 || fail "driver-not-ready"
[ -x "$PROBE" ] || fail "cuda-probe-missing"

if "$PROBE" > "$OUT.tmp" 2>"$RUN/cuda-probe.stderr"; then
    mv "$OUT.tmp" "$OUT"
else
    rm -f "$OUT.tmp"
    fail "cuda-probe-failed"
fi

grep -q '"status":"PASS"' "$OUT" || fail "cuda-probe-nonpass"
[ -r "$ETC/nodeos.conf" ] && . "$ETC/nodeos.conf"
if [ -n "${NODEOS_EXPECTED_CC:-}" ]; then
    grep -Fq "\"compute_capability\":\"$NODEOS_EXPECTED_CC\"" "$OUT" || fail "cuda-capability-mismatch"
fi
[ "$QUIET" -eq 1 ] || cat "$OUT"
