#!/bin/sh
# nodeos-netgate: direct-LAN network gate (link + ping + optional iperf3).
#   nodeos-netgate [--ping|--full|--link]
# Writes $NODEOS_RUN/network.json (evidence) and network.env (console/agent).
# Exit 0 = PASS or SKIPPED (no peer configured), 1 = FAIL.
set -eu
NODEOS_LIB=${NODEOS_LIB:-/usr/lib/nodeos/nodeos-lib.sh}
. "$NODEOS_LIB"
nodeos_load_conf

mode=ping
case "${1:-}" in
    --full) mode=full ;;
    --link) mode=link ;;
    --ping|"") ;;
    *) echo "usage: nodeos-netgate [--ping|--full|--link]" >&2; exit 2 ;;
esac

PEER=${NODEOS_PEER_IPV4:-}
MIN_LINK=${NODEOS_MIN_LINK_MBIT:-0}
MIN_TP=${NODEOS_MIN_THROUGHPUT_MBIT:-0}
EXPECT_DUPLEX=${NODEOS_EXPECT_DUPLEX:-}
[ -z "$EXPECT_DUPLEX" ] && [ "$MIN_LINK" -gt 0 ] && EXPECT_DUPLEX=full
PING_COUNT=${NODEOS_PING_COUNT:-4}
IPERF_SECONDS=${NODEOS_IPERF_SECONDS:-5}
mkdir -p "$NODEOS_RUN"

reasons=""
add() { reasons="${reasons:+$reasons,}$1"; }
is_num() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; return 0; }
lt() { awk -v a="$1" -v b="$2" 'BEGIN{exit !(a+0<b+0)}'; }

nodeos_net_collect

# ---- link ---------------------------------------------------------------
[ -n "$NET_IFACE" ] || add no-nic
if [ -n "$NET_IFACE" ]; then
    [ "$NET_CARRIER" = 1 ] || add no-carrier
    if [ "$MIN_LINK" -gt 0 ] && [ "$NET_CARRIER" = 1 ]; then
        if ! is_num "$NET_SPEED"; then add link-speed-unknown
        elif [ "$NET_SPEED" -lt "$MIN_LINK" ]; then add link-speed-low; fi
    fi
    if [ -n "$EXPECT_DUPLEX" ] && [ -n "$NET_DUPLEX" ] && [ "$NET_DUPLEX" != "$EXPECT_DUPLEX" ]; then
        add link-duplex
    fi
    errs=0
    is_num "$NET_RX_ERRORS" && errs=$((errs + NET_RX_ERRORS))
    is_num "$NET_TX_ERRORS" && errs=$((errs + NET_TX_ERRORS))
    [ "$errs" -eq 0 ] || add link-errors
else
    errs=0
fi

# ---- ping ---------------------------------------------------------------
PING_RESULT=SKIPPED; LOSS=""; RTT=""
if [ -n "$PEER" ] && [ "$mode" != link ]; then
    if [ "$NET_CARRIER" = 1 ] && [ -n "$NET_IPV4" ]; then
        pout=$(ping -c "$PING_COUNT" -W 1 -I "$NET_IFACE" -q "$PEER" 2>&1) || true
        LOSS=$(printf '%s\n' "$pout" | sed -n 's/.* \([0-9][0-9]*\)% packet loss.*/\1/p' | head -n 1)
        RTT=$(printf '%s\n' "$pout" | sed -n 's|.*= \([0-9.]*\)/\([0-9.]*\)/.*|\2|p' | head -n 1)
        if [ -z "$LOSS" ] || [ "$LOSS" -ge 100 ]; then
            PING_RESULT=FAIL; add peer-unreachable
        elif [ "$LOSS" -gt 0 ]; then
            PING_RESULT=FAIL; add ping-loss
        else
            PING_RESULT=PASS
        fi
    else
        PING_RESULT=FAIL
        # link reasons already explain this; make it explicit when only IP is missing
        [ "$NET_CARRIER" = 1 ] && add no-ipv4
    fi
fi

# ---- iperf3 -------------------------------------------------------------
IPERF_ENV="$NODEOS_RUN/iperf.env"
if [ "$mode" = full ] && [ "$PING_RESULT" = PASS ]; then
    IPERF_RESULT=SKIPPED_NO_IPERF3; IPERF_MBIT=""
    if command -v iperf3 >/dev/null 2>&1; then
        TMO=""; command -v timeout >/dev/null 2>&1 && TMO="timeout $((IPERF_SECONDS + 10))"
        iout=$($TMO iperf3 -c "$PEER" -t "$IPERF_SECONDS" -f m 2>&1) && irc=0 || irc=$?
        IPERF_MBIT=$(printf '%s\n' "$iout" | sed -n 's/.*[[:space:]]\([0-9.][0-9.]*\)[[:space:]]*Mbits\/sec.*/\1/p' | tail -n 1)
        if [ "$irc" -ne 0 ] || [ -z "$IPERF_MBIT" ]; then
            IPERF_RESULT=SKIPPED_NO_SERVER; IPERF_MBIT=""
        elif [ "$MIN_TP" -gt 0 ] && lt "$IPERF_MBIT" "$MIN_TP"; then
            IPERF_RESULT=FAIL
        else
            IPERF_RESULT=PASS
        fi
    fi
    {
        printf 'IPERF_RESULT=%s\n' "$(sq "$IPERF_RESULT")"
        printf 'IPERF_MBIT=%s\n' "$(sq "$IPERF_MBIT")"
        printf 'IPERF_SECONDS=%s\n' "$(sq "$IPERF_SECONDS")"
    } >"$IPERF_ENV.$$"
    mv -f "$IPERF_ENV.$$" "$IPERF_ENV"
fi
IPERF_RESULT=""; IPERF_MBIT=""; IPERF_SECONDS=""
if [ -r "$IPERF_ENV" ]; then . "$IPERF_ENV"; fi
case "${IPERF_RESULT:-}" in
    FAIL) add throughput-low ;;
    SKIPPED_*) [ "${NODEOS_REQUIRE_IPERF:-0}" != 1 ] || add iperf-unavailable ;;
    "") [ "${NODEOS_REQUIRE_IPERF:-0}" != 1 ] || add iperf-unavailable ;;
esac

# ---- verdict ------------------------------------------------------------
if [ -n "$reasons" ]; then STATUS=FAIL
elif [ "$mode" = link ]; then STATUS=SKIPPED; reasons="link-only"
elif [ -z "$PEER" ]; then STATUS=SKIPPED; reasons="no-peer-configured"
else STATUS=PASS; fi
FIRST_REASON=${reasons%%,*}
UPTIME_S=$(rd "$NODEOS_PROCFS/uptime"); UPTIME_S=${UPTIME_S%%.*}; UPTIME_S=${UPTIME_S%% *}

{
    for v in STATUS reasons FIRST_REASON PEER PING_RESULT LOSS RTT IPERF_RESULT IPERF_MBIT IPERF_SECONDS \
             NET_SPEED NET_DUPLEX errs UPTIME_S; do
        eval "val=\${$v:-}"
        case "$v" in
            STATUS) n=NG_STATUS ;; reasons) n=NG_REASONS ;; FIRST_REASON) n=NG_REASON ;;
            PEER) n=NG_PEER ;; PING_RESULT) n=NG_PING_RESULT ;; LOSS) n=NG_LOSS ;; RTT) n=NG_RTT ;;
            IPERF_RESULT) n=NG_IPERF_RESULT ;; IPERF_MBIT) n=NG_IPERF_MBIT ;;
            IPERF_SECONDS) n=NG_IPERF_SECONDS ;; NET_SPEED) n=NG_SPEED ;; NET_DUPLEX) n=NG_DUPLEX ;;
            errs) n=NG_ERRORS ;; UPTIME_S) n=NG_UPTIME_S ;;
        esac
        printf '%s=%s\n' "$n" "$(sq "$val")"
    done
} >"$NODEOS_RUN/network.env.$$"
mv -f "$NODEOS_RUN/network.env.$$" "$NODEOS_RUN/network.env"

{
    printf '{\n'
    printf '  "schema":"resonarch.nodeos.network.v1",\n'
    printf '  "status":"%s",\n' "$STATUS"
    printf '  "reason":"%s",\n' "$(json_escape "$reasons")"
    printf '  "mode":"%s","uptime_s":%s,\n' "$mode" "$(json_num "$UPTIME_S")"
    printf '  "link":{"interface":"%s","ipv4":"%s","mac":"%s","driver":"%s","carrier":%s,"speed_mbps":%s,"duplex":"%s","mtu":%s,' \
        "$(json_escape "$NET_IFACE")" "$(json_escape "$NET_IPV4")" "$(json_escape "$NET_MAC")" "$(json_escape "$NET_DRIVER")" \
        "$(json_bool "$NET_CARRIER")" "$(json_num "$NET_SPEED")" "$(json_escape "$NET_DUPLEX")" "$(json_num "$NET_MTU")"
    printf '"rx_bytes":%s,"tx_bytes":%s,"rx_errors":%s,"tx_errors":%s,"rx_dropped":%s,"tx_dropped":%s},\n' \
        "$(json_num "$NET_RX_BYTES")" "$(json_num "$NET_TX_BYTES")" "$(json_num "$NET_RX_ERRORS")" \
        "$(json_num "$NET_TX_ERRORS")" "$(json_num "$NET_RX_DROPPED")" "$(json_num "$NET_TX_DROPPED")"
    printf '  "peer":{"ipv4":"%s","ping":{"result":"%s","loss_pct":%s,"rtt_ms":%s}},\n' \
        "$(json_escape "$PEER")" "$PING_RESULT" "$(json_num "$LOSS")" "$(json_num "$RTT")"
    printf '  "iperf":{"result":"%s","mbit_s":%s,"seconds":%s},\n' \
        "$(json_escape "${IPERF_RESULT:-NOT_RUN}")" "$(json_num "${IPERF_MBIT:-}")" "$(json_num "${IPERF_SECONDS:-}")"
    printf '  "thresholds":{"min_link_mbps":%s,"min_throughput_mbit_s":%s,"expect_duplex":"%s"}\n' \
        "$(json_num "$MIN_LINK")" "$(json_num "$MIN_TP")" "$(json_escape "$EXPECT_DUPLEX")"
    printf '}\n'
} >"$NODEOS_RUN/network.json.$$"
mv -f "$NODEOS_RUN/network.json.$$" "$NODEOS_RUN/network.json"

echo "carrier             ${NET_CARRIER:-?}"
echo "speed               ${NET_SPEED:-?} Mb/s ${NET_DUPLEX:-?}"
echo "peer ping           $PING_RESULT${PEER:+ ($PEER)}"
[ -z "$RTT" ] || echo "RTT                 $RTT ms"
[ -z "$LOSS" ] || echo "packet loss         $LOSS %"
echo "iperf3              ${IPERF_RESULT:-NOT_RUN}${IPERF_MBIT:+ $IPERF_MBIT Mbit/s}"
echo "link errors         $errs"
echo "NETWORK GATE        $STATUS${reasons:+ ($reasons)}"
[ "$STATUS" != FAIL ]
